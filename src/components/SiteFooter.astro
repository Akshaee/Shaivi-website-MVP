---
import ContactCard from "./ContactCard.astro";
import content from "../data/content.json";
import sizes from "../assets/brand/logo-sizes.json";

const { company, about } = content;
const year = new Date().getFullYear();
const logoW = Math.round((sizes.horizontal.width / sizes.horizontal.height) * 44);

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Products", href: "/products/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy Policy", href: "/privacy-policy/" },
];
---

<footer class="on-dark bg-brand-deep text-royal-100">
  <div class="container-page py-14 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <img
          src="/brand/shaivi-logo-horizontal-white.svg"
          alt={`${company.brand} — ${company.tagline}`}
          width={logoW}
          height={44}
          class="h-11 w-auto"
          loading="lazy"
          decoding="async"
        />
        <p class="mt-6 font-accent text-sm font-semibold uppercase tracking-eyebrow text-royal-200">
          {company.tagline}
        </p>
        <p class="mt-3 text-base text-royal-100">{company.certification}</p>
      </div>

      <nav aria-label="Footer" class="lg:col-span-4">
        <div class="grid gap-10 sm:grid-cols-2">
          <div>
            <h2 class="text-base font-semibold uppercase tracking-wide text-white">Quick links</h2>
            <ul class="m-0 mt-4 flex list-none flex-col gap-1 p-0">
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href} class="flex min-h-[44px] items-center text-royal-100 no-underline hover:text-white hover:underline">
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="text-base font-semibold uppercase tracking-wide text-white">Products</h2>
            <ul class="m-0 mt-4 flex list-none flex-col gap-1 p-0">
              {
                about.categories.map((category) => (
                  <li>
                    <a
                      href={`/products/#${category.id}`}
                      class="flex min-h-[44px] items-center text-royal-100 no-underline hover:text-white hover:underline"
                    >
                      {category.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </nav>

      <div class="lg:col-span-4">
        <ContactCard onDark headingLevel="h2" />
      </div>
    </div>

    <p class="mt-14 border-t border-white/20 pt-6 text-sm text-royal-200">
      © {year} {company.legalName}. All rights reserved.
    </p>
  </div>
</footer>
