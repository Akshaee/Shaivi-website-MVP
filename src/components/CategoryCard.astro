---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface Props {
  name: string;
  href: string;
  icon?: IconName;
  /** Shown instead of the icon, for the one category the brochure illustrates. */
  image?: ImageMetadata;
}
const { name, href, icon, image } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-card border border-border bg-white p-6 no-underline shadow-soft transition-colors duration-200 ease-out-soft hover:border-royal-300 focus-visible:border-royal-300"
>
  {/*
    The image is decorative here: the card's heading and its "View details" text
    already name the category, so alt text would only repeat it. The same photo
    carries its real alt on the Products page.
  */}
  <!-- Fixed height either way, so every card's heading sits on the same line. -->
  <span class="flex h-24 shrink-0 items-center">
    {image ? (
      <Picture
        src={image}
        alt=""
        widths={[160, 240, 320]}
        sizes="160px"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        loading="lazy"
        class="h-24 w-auto object-contain"
      />
    ) : (
      <span class="flex size-12 items-center justify-center rounded-full bg-royal-50 text-brand-purple">
        <Icon name={icon ?? "shield-check"} size={24} />
      </span>
    )}
  </span>
  <h3 class="mt-4 text-xl text-brand-plum">{name}</h3>
  <span class="mt-auto pt-4 inline-flex items-center gap-1.5 font-semibold text-brand-indigo">
    View details<span class="sr-only-custom">: {name}</span>
    <Icon name="chevron-right" size={18} />
  </span>
</a>
