---
interface Props {
  text: string;
  as?: "h2" | "p";
  id?: string;
  class?: string;
}
const { text, as = "h2", id, class: className = "" } = Astro.props;
const Tag = as;
---

<div class={`flex justify-center ${className}`}>
  <div class="orb">
    <Tag id={id} class="text-xl font-semibold leading-snug text-white sm:text-2xl">
      {text}
    </Tag>
    <slot />
  </div>
</div>
