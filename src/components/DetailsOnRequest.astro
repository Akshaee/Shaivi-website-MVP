---
import Button from "./Button.astro";
import content from "../data/content.json";

interface Props {
  categoryId: string;
  categoryName: string;
}
const { categoryId, categoryName } = Astro.props;
const { ui } = content;
---

<div class="mt-4">
  <p class="text-base text-text-muted">{ui.detailsOnRequest}</p>
  <Button
    href={`/contact/?enquiry=product&product=${categoryId}`}
    variant="secondary"
    class="mt-5"
    arrow
  >
    {ui.detailsCta}<span class="sr-only-custom">: {categoryName}</span>
  </Button>
</div>
