# Copy to .env (git-ignored) and set the same variables in Vercel.

# Absolute site origin, no trailing slash.
PUBLIC_SITE_URL="https://www.dhrithisurgicalsolutions.com"

# Pitch mode: keep false until the client approves the site for launch.
PUBLIC_SITE_INDEXABLE="false"

# Enquiry delivery: log | resend | smtp | webhook. "log" never sends real email.
CONTACT_DELIVERY="log"
CONTACT_TO_EMAIL=""

# Set when CONTACT_DELIVERY=resend.
RESEND_API_KEY=""

# Optional Cloudflare Turnstile. Leave both empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Random string used to salt the SHA-256 hash of client IPs in logs.
IP_HASH_SALT=""

# Per-client enquiry rate limits.
RATE_LIMIT_PER_10_MIN="5"
RATE_LIMIT_PER_DAY="20"
