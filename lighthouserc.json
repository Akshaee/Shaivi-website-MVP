{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs 4321",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/about/",
        "http://localhost:4321/products/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/privacy-policy/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["is-crawlable"],
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 100
          }
        ],
        "speed-index": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 25000
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 450000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
