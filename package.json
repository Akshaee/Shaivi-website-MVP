{
  "name": "shaivi-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4321",
    "preview:ci": "astro preview --port 4321 --ignore-lock",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/check-seo.mjs",
    "test:content": "node scripts/check-content.mjs",
    "test:contrast": "node scripts/contrast.mjs",
    "test:html": "html-validate --config htmlvalidate.config.mjs \"dist/client/**/*.html\"",
    "test:links": "linkinator --config linkinator.config.json /",
    "lhci": "lhci autorun",
    "audit": "npm audit --omit=dev --audit-level=high && npm audit signatures",
    "assets": "node scripts/build-assets.mjs",
    "verify": "npm run build && npm run test:seo && npm run test:content && npm run test:contrast && npm run test:html && npm run test:links && npm run test:e2e && npm run lhci && npm run audit",
    "audit:dev": "npm audit --audit-level=high",
    "lint": "eslint \"scripts/**/*.mjs\" \"eslint.config.js\"",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{mjs,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{mjs,js,json}\""
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.16.0",
    "linkinator": "^8.1.0",
    "node-html-parser": "^9.0.4",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "subset-font": "^2.7.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "wawoff2": "^2.0.1"
  }
}
