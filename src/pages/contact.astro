---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactCard from "../components/ContactCard.astro";
import Icon from "../components/Icon.astro";
import content from "../data/content.json";
import { nonBreakingPhone } from "../lib/text";
import { breadcrumbList, contactPage, organization } from "../lib/schema";

const { contact } = content;
const firstPhone = contact.phones[0]!;
const whatsapp = contact.whatsapp;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Contact", href: "/contact/" },
];

const quickLink =
  "flex min-h-[48px] items-center gap-3 rounded-xl border border-border bg-white px-4 py-3 font-semibold text-brand-ink-indigo no-underline";
---

<BaseLayout
  seoKey="/contact/"
  breadcrumbs={breadcrumbs}
  actionBar={false}
  schema={[organization(Astro.site), breadcrumbList(breadcrumbs, Astro.site), contactPage(Astro.site)]}
>
  <section class="container-page pt-8 pb-4 lg:pt-12" aria-labelledby="contact-heading">
    <h1 id="contact-heading" class="text-4xl text-brand-ink-indigo">Contact Dhrithi Surgical Solutions</h1>
    <p class="mt-5 prose-measure text-lg text-text-muted">
      Tell us which products, sizes and quantities you need, or describe the customised drape, kit or gown you have
      in mind.
    </p>
  </section>

  <!-- Status targets for the no-JavaScript submission path. -->
  <section id="enquiry-sent" class="status-target container-page" aria-labelledby="enquiry-sent-heading">
    <div class="mt-8 rounded-card border-2 border-success bg-success-bg p-6">
      <h2 id="enquiry-sent-heading" class="text-2xl text-success">Thank you — your enquiry has been sent.</h2>
      <p class="mt-3 text-base">We have your details and will be in touch.</p>
    </div>
  </section>

  <section id="enquiry-error" class="status-target container-page" aria-labelledby="enquiry-error-heading">
    <div class="mt-8 rounded-card border-2 border-danger bg-danger-bg p-6">
      <h2 id="enquiry-error-heading" class="text-2xl text-danger">We couldn’t send your enquiry.</h2>
      <p class="mt-3 text-base">
        Please check your details and try again, or call
        <a href={firstPhone.tel}>{nonBreakingPhone(firstPhone.display)}</a> or email
        <a class="break-anywhere" href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
    </div>
  </section>

  <div class="container-page section-y">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <!-- Quick contact comes first on mobile. -->
        <section class="rounded-card border border-border bg-surface-tint p-5" aria-labelledby="quick-contact-heading">
          <h2 id="quick-contact-heading" class="text-xl text-brand-plum">Reach us directly</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <a href={firstPhone.tel} class={quickLink}>
              <Icon name="phone" size={20} class="text-brand-purple" />
              {nonBreakingPhone(firstPhone.display)}
            </a>
            <a href={`mailto:${contact.email}`} class={`${quickLink} break-anywhere`}>
              <Icon name="mail" size={20} class="shrink-0 text-brand-purple" />
              Email us
            </a>
            {
              whatsapp.enabled && whatsapp.number && (
                <a
                  href={`https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.prefill)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={quickLink}
                >
                  <Icon name="message-circle" size={20} class="text-brand-purple" />
                  WhatsApp
                </a>
              )
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="enquiry-heading">
          <h2 id="enquiry-heading" class="text-3xl text-gradient">Send an enquiry</h2>
          <div class="mt-8">
            <ContactForm />
          </div>
        </section>
      </div>

      <div class="lg:col-span-5">
        <section
          class="rounded-card border border-border bg-white p-6 shadow-soft lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]"
          aria-labelledby="office-heading"
        >
          <h2 id="office-heading" class="text-2xl text-brand-plum">{contact.officeLabel}</h2>
          <ContactCard showHeading={false} class="mt-5" />
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* The status panels are hidden until the API redirects to their anchor. */
  .status-target {
    display: none;
  }
  .status-target:target {
    display: block;
  }
</style>

<script src="../scripts/enquiry-preselect.ts"></script>
