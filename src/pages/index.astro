---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import BridgeBand from "../components/BridgeBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatCard from "../components/StatCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import OrbCallout from "../components/OrbCallout.astro";
import FeatureChips from "../components/FeatureChips.astro";
import LeaderCard from "../components/LeaderCard.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import content from "../data/content.json";
import { photos, cutouts, altFor } from "../lib/images";
import { firstSentence } from "../lib/text";
import { organization, webSite } from "../lib/schema";
import type { IconName } from "../components/Icon.astro";

const { company, about, infrastructure, leadership, gowns, ui } = content;
const md = leadership.people[0]!;
const qualityStandards = infrastructure.items.find((i) => i.id === "quality-standards")!;

// Shared by the <Picture> below and the head preload, so both ask for the same files.
const HERO_WIDTHS = [360, 480, 720, 960];
const HERO_SIZES = "(min-width: 1024px) 34vw, 88vw";
---

<BaseLayout
  seoKey="/"
  schema={[organization(Astro.site), webSite(Astro.site)]}
>
  <!-- 1 · Hero ---------------------------------------------------------- -->
  <section class="container-page pt-10 pb-16 lg:pt-16 lg:pb-24" aria-labelledby="hero-heading">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:order-2 lg:col-span-7">
        <p class="font-accent text-sm font-semibold uppercase tracking-eyebrow text-brand-magenta">
          {company.tagline}
        </p>
        <h1 id="hero-heading" class="mt-5">
          <span class="block font-script text-script leading-none text-brand-plum">{company.heroScriptWord}</span>
          {" "}
          <span class="mt-1 block text-4xl uppercase tracking-[0.01em] text-brand-ink-indigo">
            {company.heroHeadline}
          </span>
        </h1>
        <p class="mt-7 inline-flex items-center gap-2 rounded-full bg-brand-deep px-4 py-2 text-sm font-semibold text-white">
          <Icon name="award" size={18} />
          {company.certification}
        </p>
        <p class="mt-5 text-lg font-semibold text-brand-ink-indigo">{company.legalName}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href="/contact/" arrow>{ui.primaryCta}</Button>
          <Button href="/products/" variant="secondary">{ui.secondaryCta}</Button>
        </div>
      </div>

      <!-- The photo has a pure white background, so it sits directly on white. -->
      <div class="lg:order-1 lg:col-span-5">
        <Picture
          src={photos["hero-nurse"]}
          alt={altFor("hero-nurse")}
          widths={HERO_WIDTHS}
          sizes={HERO_SIZES}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          quality={64}
          priority
          {/* Width-driven, never height-driven: a max-height with w-auto leaves the
              box undetermined until the image loads, which shifted everything
              below it. At 18rem the portrait crop lands at roughly 55svh on a
              phone, which is what the brief asks for. */}
          class="mx-auto w-full max-w-[18rem] rounded-photo object-contain sm:max-w-[22rem] lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <!-- 2 · Bridge band --------------------------------------------------- -->
  <section aria-labelledby="bridge-heading">
    <BridgeBand lines={company.coverTagline} headingId="bridge-heading" overlap />
  </section>

  <!-- 3 · Built for quality --------------------------------------------- -->
  <section class="container-page section-y" aria-labelledby="infrastructure-heading">
    <SectionHeading
      id="infrastructure-heading"
      ribbon={infrastructure.label}
      heading={infrastructure.heading}
      intro={infrastructure.intro}
      gradient
    />
    <ul class="mt-10 grid list-none grid-cols-2 gap-5 p-0 lg:grid-cols-4">
      {
        infrastructure.items.map((item) => (
          <li>
            <StatCard
              stat={item.stat}
              title={item.title}
              text={item.id === "quality-standards" ? qualityStandards.textShort! : item.text}
              icon={item.icon as IconName}
            />
          </li>
        ))
      }
    </ul>
    <a href="/about/#infrastructure" class="mt-8 inline-flex min-h-[44px] items-center gap-2 font-semibold">
      About our infrastructure
      <Icon name="arrow-right" size={18} />
    </a>
  </section>

  <!-- 4 · What we manufacture -------------------------------------------- -->
  <section class="bg-surface-tint" aria-labelledby="manufacture-heading">
    <div class="container-page section-y">
      <SectionHeading
        id="manufacture-heading"
        eyebrow={about.manufacturersHeading}
        heading="Surgical disposables and protective products"
        gradient
      />
      <ul class="mt-10 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          about.categories.map((category) => (
            <li>
              <CategoryCard name={category.name} href={`/products/#${category.id}`} icon={category.icon as IconName} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5 · Customisation orb ---------------------------------------------- -->
  <section class="container-page section-y" aria-labelledby="customisation-heading">
    <OrbCallout text={about.customisation} as="h2" id="customisation-heading" />
    <div class="mt-10 flex justify-center">
      <Button href="/contact/?enquiry=custom" variant="secondary" arrow>Discuss a custom requirement</Button>
    </div>
  </section>

  <!-- 6 · Gowns highlight ------------------------------------------------ -->
  <section class="container-page" aria-labelledby="gowns-heading">
    <div class="violet-panel overflow-hidden px-6 py-12 lg:px-12 lg:py-16">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="gowns-heading" class="text-3xl text-white">{gowns.heading}</h2>
          <p class="mt-5 prose-measure text-lg text-royal-50">{gowns.intro[0]}</p>
          <FeatureChips items={gowns.features} onDark label="Gown features" class="mt-7" />
          <Button href="/products/#gowns" variant="on-dark" class="mt-8" arrow>View the gown range</Button>
        </div>
        <div class="lg:col-span-5">
          <Picture
            src={cutouts["surgical-gown-model"]}
            alt={altFor("surgical-gown-model")}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 30vw, 70vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            class="mx-auto w-full max-w-[22rem] object-contain"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · About teaser ---------------------------------------------------- -->
  <section class="container-page section-y" aria-labelledby="about-teaser-heading">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <SectionHeading id="about-teaser-heading" ribbon={about.label} heading={about.heading} gradient />
        <p class="mt-5 prose-measure text-lg text-text-muted">{firstSentence(about.paragraphs[0]!)}</p>
        <a href="/about/" class="mt-7 inline-flex min-h-[44px] items-center gap-2 font-semibold">
          More about us
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="lg:col-span-6">
        <Picture
          src={photos["factory-bhatkal"]}
          alt={altFor("factory-bhatkal")}
          widths={[480, 720, 1024]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          loading="lazy"
          class="w-full rounded-photo object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 8 · Leadership teaser ----------------------------------------------- -->
  <section class="bg-surface-tint" aria-labelledby="leadership-teaser-heading">
    <div class="container-page section-y">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <SectionHeading id="leadership-teaser-heading" ribbon={leadership.label} heading={leadership.heading} gradient />
          <a href="/about/#leadership" class="mt-7 inline-flex min-h-[44px] items-center gap-2 font-semibold">
            Meet our leadership
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <div class="lg:col-span-5">
          <LeaderCard
            image={photos["md-sharath-kumar-shetty"]}
            alt={altFor("md-sharath-kumar-shetty")}
            name={md.name}
            role={md.role}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · Mission CTA band ------------------------------------------------ -->
  <CtaBand />
</BaseLayout>
