---
import Icon from "./Icon.astro";

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  trail: Crumb[];
}
const { trail } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-page pt-6">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 p-0 text-sm text-text-muted list-none">
    {trail.map((crumb, i) => {
      const last = i === trail.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {i > 0 && <Icon name="chevron-right" size={14} class="text-neutral-400" />}
          {last ? (
            <span aria-current="page" class="font-semibold text-brand-plum">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href} class="py-1 text-brand-indigo">
              {crumb.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
